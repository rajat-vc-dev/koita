<script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
<script src="{{ asset('js/site.js') }}"></script>
<script>
$(document).ready(function () {
    function wordCount(text) {
        text = $.trim(text || '');
        return text ? text.split(/\s+/).length : 0;
    }

    function showErr(message, selector) {
        $('#err').text(message);
        if (selector) $(selector).focus();
        $('html, body').animate({ scrollTop: $('#formTop').offset().top - 20 }, 200);
        return false;
    }

    function isValidHttpUrl(value) {
        var urlToCheck = $.trim(value || '');
        if (!urlToCheck) {
            return false;
        }
        if (!/^https?:\/\//i.test(urlToCheck)) {
            urlToCheck = 'https://' + urlToCheck;
        }
        try {
            var parsed = new URL(urlToCheck);
            return (parsed.protocol === 'http:' || parsed.protocol === 'https:')
                && parsed.hostname
                && parsed.hostname.indexOf('.') !== -1;
        } catch (e) {
            return false;
        }
    }

    var deckMaxBytes = 20 * 1024 * 1024;
    var deckAllowedExt = ['pdf', 'ppt', 'pptx'];

    function deckExtension(file) {
        if (!file || !file.name) {
            return '';
        }
        var parts = file.name.split('.');
        return parts.length > 1 ? parts.pop().toLowerCase() : '';
    }

    function validateDeckFile(file, clearOnError) {
        if (!file) {
            return showErr('Please upload your PPT / PDF', '#deck');
        }
        var ext = deckExtension(file);
        if ($.inArray(ext, deckAllowedExt) === -1) {
            if (clearOnError) {
                $('#deck').val('');
                $('#deckLabel').text('Click to upload PPT / PDF');
            }
            return showErr('Only PDF, PPT, or PPTX files are allowed', '#deck');
        }
        if (file.size > deckMaxBytes) {
            if (clearOnError) {
                $('#deck').val('');
                $('#deckLabel').text('Click to upload PPT / PDF');
            }
            return showErr('Deck must be 20MB or less', '#deck');
        }
        $('#err').text('');
        return true;
    }

    function toggleOther(checkboxSelector, wrapSelector) {
        var checked = false;
        $(checkboxSelector + ':checked').each(function () {
            if ($(this).val() === 'Other') checked = true;
        });
        $(wrapSelector).toggle(checked);
        if (!checked) $(wrapSelector).find('input').val('');
    }

    $('.primary-area').on('change', function () { toggleOther('.primary-area', '#primaryAreaOtherWrap'); });
    $('.users-of').on('change', function () { toggleOther('.users-of', '#usersOtherWrap'); });
    toggleOther('.primary-area', '#primaryAreaOtherWrap');
    toggleOther('.users-of', '#usersOtherWrap');

    function toggleUserCount() {
        var v = $('input[name="adoption_stage"]:checked').val();
        $('#user_count').toggle(v === 'pilot' || v === 'scale');
    }
    $('input[name="adoption_stage"]').on('change', toggleUserCount);
    toggleUserCount();

    $('textarea[data-words]').each(function () {
        var $t = $(this);
        var max = +$t.data('words');
        var $hint = $t.prev('.hint');
        var base = $hint.length ? $hint.text() : '';
        $t.on('input', function () {
            if ($hint.length) $hint.text(base + ' (' + wordCount($t.val()) + '/' + max + ')');
        }).trigger('input');
    });

    $('#deck').on('change', function () {
        var f = this.files[0];
        if (!f) {
            $('#deckLabel').text('Click to upload PPT / PDF');
            return;
        }
        if (!validateDeckFile(f, true)) {
            return;
        }
        $('#deckLabel').text(f.name);
    });

    $('#step1Form').on('submit', function () {
        $('#err').text('');
        if (!$('.primary-area:checked').length) return showErr('Please select at least one primary area of work', '.primary-area:first');
        if ($('.primary-area[value="Other"]').is(':checked') && $.trim($('#primary_area_other').val()) === '') {
            return showErr('Please specify the other area of work', '#primary_area_other');
        }
        if ($.trim($('#mission_overview').val()) === '') return showErr('Please enter mission overview', '#mission_overview');
        if (wordCount($('#mission_overview').val()) > 200) return showErr('Mission overview must be 200 words or less', '#mission_overview');
        $('#step1Btn').prop('disabled', true);
        return true;
    });

    $('#step2Form').on('submit', function () {
        $('#err').text('');
        if ($.trim($('#solution_name').val()) === '') return showErr('Please enter solution name', '#solution_name');
        if ($.trim($('#social_problem').val()) === '') return showErr('Please describe the social problem', '#social_problem');
        if (wordCount($('#social_problem').val()) > 250) return showErr('Social problem must be 250 words or less', '#social_problem');
        if ($.trim($('#solution_description').val()) === '') return showErr('Please describe your AI solution', '#solution_description');
        if (wordCount($('#solution_description').val()) > 250) return showErr('Solution description must be 250 words or less', '#solution_description');
        if (!$('.users-of:checked').length) return showErr('Please select users of the solution', '.users-of:first');
        if ($('.users-of[value="Other"]').is(':checked') && $.trim($('#users_other').val()) === '') {
            return showErr('Please specify other users', '#users_other');
        }
        if ($.trim($('#technical_details').val()) === '') return showErr('Please share technical details', '#technical_details');
        if (wordCount($('#technical_details').val()) > 200) return showErr('Technical details must be 200 words or less', '#technical_details');
        if ($.trim($('#demo_video_url').val()) === '') return showErr('Please add demo video link', '#demo_video_url');
        if (!isValidHttpUrl($('#demo_video_url').val())) return showErr('Please enter a valid demo video link', '#demo_video_url');
        if ($.trim($('#testimonial_video_url').val()) === '') return showErr('Please add testimonial video link', '#testimonial_video_url');
        if (!isValidHttpUrl($('#testimonial_video_url').val())) return showErr('Please enter a valid testimonial video link', '#testimonial_video_url');
        $('#step2Btn').prop('disabled', true);
        return true;
    });

    $('#step3Form').on('submit', function () {
        $('#err').text('');
        if (!$('input[name="adoption_stage"]:checked').length) return showErr('Please select adoption stage', 'input[name="adoption_stage"]:first');
        var stage = $('input[name="adoption_stage"]:checked').val();
        if ((stage === 'pilot' || stage === 'scale') && $.trim($('#user_count').val()) === '') {
            return showErr('Please enter number of users', '#user_count');
        }
        if ($.trim($('#success_measurement').val()) === '') return showErr('Please describe how you measure success', '#success_measurement');
        if (wordCount($('#success_measurement').val()) > 250) return showErr('Success measurement must be 250 words or less', '#success_measurement');
        if ($.trim($('#outcomes_impact').val()) === '') return showErr('Please describe outcomes / impact', '#outcomes_impact');
        if (wordCount($('#outcomes_impact').val()) > 250) return showErr('Outcomes must be 250 words or less', '#outcomes_impact');
        if (!validateDeckFile($('#deck')[0].files[0], false)) return false;
        if ($.trim($('#brand_asset_url').val()) === '') return showErr('Please enter the brand asset URL', '#brand_asset_url');
        if (!isValidHttpUrl($('#brand_asset_url').val())) return showErr('Please enter a valid brand asset URL', '#brand_asset_url');
        if (!$('#consent').is(':checked')) return showErr('Please confirm the consent checkbox', '#consent');
        $('#step3Btn').prop('disabled', true);
        return true;
    });
});
</script>
@endpush
